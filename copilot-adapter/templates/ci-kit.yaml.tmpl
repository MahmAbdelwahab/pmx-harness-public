# This installed workflow runs the portable checks in the target checkout.
# The full public battery requires the separate scientific and report stack.
name: ci

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

jobs:
  kit-battery:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Install lightweight CI dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends r-base-core r-cran-digest r-cran-yaml r-cran-jsonlite python3 python3-yaml

      - name: Production ledger preflight
        run: Rscript tools/ci_check.R --ledger-only

      - name: CI battery (light mode)
        run: Rscript tools/ci_check.R --light

      - name: PreToolUse guard test suite
        run: bash tools/tests/test_protect_paths.sh

      - name: Copilot adapter test suite
        run: bash copilot-adapter/tests/test_setup.sh

      - name: Copilot adapter generated files
        run: python3 copilot-adapter/setup.py check
