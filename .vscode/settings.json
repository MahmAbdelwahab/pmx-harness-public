// generated by copilot-adapter/setup.py from copilot-adapter/profile — edit the profile, then run install
{
  // Gate signatures bind exact generated bytes. Preserve Markdown formatting on
  // save and apply signatures through the documented local process.
  "[markdown]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "files.trimTrailingWhitespace": false,
    "files.insertFinalNewline": false,
    "files.trimFinalNewlines": false,
    "editor.wordWrap": "on"
  },
  // Editor-native second barrier, independent of hooks: shell writes into the
  // protected directories are excluded from terminal auto-approval. This is a
  // deny-list rule (`approve: false`, `matchCommandLine: true`) — it forces an
  // explicit approval PROMPT, it is never a hard block. The setting is
  // WINDOW-scoped and `restricted`, so this workspace value takes effect only
  // once the workspace is trusted. The R/CI layer remains the enforcement.
  //
  // The `chat.tools.edits` auto-approval map is deliberately NOT generated
  // here: it is declared with ConfigurationScope.APPLICATION (vscode
  // chat.shared.contribution.ts), so a workspace value is ignored outright, and
  // `false` requests an approval prompt in User settings.
  "chat.tools.terminal.autoApprove": {
    "/>>?\\s*['\\\"]?gates\\//": {
      "approve": false,
      "matchCommandLine": true
    },
    "/\\bsed\\b[^|;&]*\\s-[A-Za-z]*i[A-Za-z]*\\b[^|;&]*\\bgates\\//": {
      "approve": false,
      "matchCommandLine": true
    },
    "/\\btee\\b[^|;&]*\\bgates\\//": {
      "approve": false,
      "matchCommandLine": true
    },
    "/\\b(?:mv|cp|rm|touch|truncate|install)\\b[^|;&]*\\bgates\\//": {
      "approve": false,
      "matchCommandLine": true
    }
  },
  // Agent discovery: `chat.agentFilesLocations` defaults to BOTH `.github/agents`
  // and `.claude/agents`, and agents are not de-duplicated by name, so without
  // this entry every pmx agent is listed twice in the picker and in the agent
  // list given to the model. The generated `.github/agents/*.agent.md` are the
  // authoritative copies: they carry the explicit model
  // pins that VS Code's Claude-format reader drops or hard-maps.
  "chat.agentFilesLocations": {
    ".claude/agents": false
  },
  // Hooks are the editor-side write guard and mandate injection
  // (.github/hooks/). `chat.useHooks` defaults to true at VS Code main, but a
  // live check on 2026-09-02 found it switched off in an installed build, so
  // the workspace pins it (restricted: honoured once the workspace is trusted).
  // Claude-format hooks stay off: their command shape and matchers differ.
  // If the checkbox is greyed out as "managed by your organization", enterprise
  // policy disables hooks and this pin is inert (docs/PORTABILITY.md).
  "chat.useHooks": true,
  "chat.useClaudeHooks": false
}
