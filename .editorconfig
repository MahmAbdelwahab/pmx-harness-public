# generated by copilot-adapter/setup.py from copilot-adapter/profile — edit the profile, then run install
# EditorConfig — https://editorconfig.org
#
# Gate signatures bind exact generated bytes. Preserve Markdown whitespace.

root = true

[*]
charset = utf-8
end_of_line = lf

[*.md]
# Never trim or rewrap markdown: trailing spaces are hard line breaks, and
# gate records / signed documents are byte-exact.
trim_trailing_whitespace = false
insert_final_newline = false
max_line_length = off

[*.R]
indent_style = space
indent_size = 2
