# harness.yaml — MACHINE-LOCAL settings (copy to harness.yaml; that copy
# is git-ignored and never committed). Committed operational defaults
# live in config/engine.yaml; method decisions in the gated analysis
# declaration/MAP. This file holds only facts about THIS machine.

# --- R provision ------------------------------------------------------
# managed: development machine; setup_environment.R may install packages
#          from the pinned MPN snapshot.
# site:    regulated environment; the validated system R library is
#          authoritative. setup_environment.R refuses to run and the
#          environment check verifies packages against
#          config/r-packages.lock instead (mismatches reported, never
#          auto-fixed).
r_provision: managed

# --- NONMEM/PsN, native provision only --------------------------------
# Local NONMEM install root. bbi executes <nonmem_home>/run/nmfe75.
# Only the bbr lane needs this (PsN finds NONMEM via its own psn.conf).
# Resolved as NONMEM_HOME (environment), else the key below; when neither
# is set the environment check refuses a native-provision run rather than
# guessing a path. Under native provision the check also verifies that an
# nmfe7* executable exists at <nonmem_home>/run/.
# nonmem_home: /path/to/nonmem

# Optional env file the dispatcher sources before native execution, so
# batch / non-login contexts receive the site PATH (e.g. a profile.d
# snippet or module-load wrapper).
# nonmem_env_file: /path/to/nonmem-environment.sh

# --- NONMEM/PsN, containerized provision ------------------------------
# License mounts at runtime. There is NO default path: the license is
# resolved as NONMEM_LICENSE (environment), else the key below, else the
# run is refused with "NONMEM license not configured". No path is ever
# invented.
# nonmem_license: /path/to/nonmem.lic
#
# Local container image, resolved as NONMEM_IMAGE (environment), else the
# key below, else the committed default pmx-harness/nonmem:7.5.1. The
# tag must identify a locally available image that supplies the required
# NONMEM and PsN executables.
# nonmem_image: pmx-harness/nonmem:7.5.1
#
# The bbi executable, for the bbr estimation lane. Machine-local, so it lives
# here rather than in config/engine.yaml. bbr's own default for this is the
# bare string "bbi", which resolves through PATH; when bbi is installed
# somewhere off PATH (bbr::use_bbi() puts it under ~/.local/share/bbi by
# default) bbr::bbi_version() silently returns the empty string and every
# submit_model() fails. reference_nm_fit() takes this value as its bbi_path
# argument and refuses to start when neither the key nor PATH yields an
# executable. tools/check_environment.R probes the same key.
# bbi_path: /path/to/bbi
#
# Extra read-only mounts stay an environment variable only:
#   NONMEM_EXTRA_MOUNTS (colon-separated path list)
#
# `tools/nonmem_container.sh --show-config` prints the resolved image and
# license with the source each came from, without invoking docker.

# --- Data -------------------------------------------------------------
# Keep study data outside the repository. Declare the dataset path in
# the analysis inputs.
# `study_data_root` is RESERVED: no tool reads it yet. Analyses point at
# their dataset through inputs$<task>$external_input until data-assembly
# tasks consume this key.
# study_data_root: /path/to/study-data

# --- Environment confirmation -----------------------------------------
# `python3 copilot-adapter/setup.py install` probes THIS machine's PATH
# (R, NONMEM, PsN, bbi, quarto, tectonic, docker) and writes TWO generated
# sections into your harness.yaml, each value carrying the exact command
# that detected it.
#
# 1. The OPERATIVE section — the keys above, which the harness READS —
#    pre-filled from the probe so you review real configuration instead of
#    transcribing it:
#
#   # >>> operative settings — generated by copilot-adapter/setup.py
#   r_provision: managed
#   nonmem_home: /path/to/nonmem   # detected <UTC time> via parent of the run/ ...
#   # nonmem_license:   # not found: NONMEM_LICENSE is not set in this environment
#   # <<< end operative settings
#
#    `nonmem_license` is written only when NONMEM_LICENSE is already set in
#    your environment, and only ever as a PATH: the probe never searches for
#    a license file and never reads or copies one. `nonmem_env_file` is
#    site-provided and is never guessed. `nonmem_image` is pre-filled when
#    docker is present and the image is already built locally; extra mounts
#    stay an environment variable (NONMEM_EXTRA_MOUNTS), which no tool reads
#    from this file, so the probe names the variable rather than writing an
#    inert key.
#
# 2. The ENVIRONMENT block — the full probe REPORT, which no tool reads:
#
#   # >>> environment block — generated by copilot-adapter/setup.py
#   environment:
#     r_rscript: /usr/bin/Rscript   # detected <UTC time> via shutil.which('Rscript')
#     # nonmem_binary:   # not found: shutil.which('nmfe75', 'nmfe74', 'nmfe76')
#     psn_nm_versions: |-
#       nm751 is default
#   nonmem_provision_suggested: native   # detected <UTC time> via ...
#   # <<< end environment block
#
# Review both, correct anything wrong, then set `environment_confirmed:
# true`. tools/check_environment.R — the first target of every pipeline —
# refuses to run until that flag is true, so nothing ever executes against
# an unreviewed environment.
#
#   python3 copilot-adapter/setup.py env                  re-probe, report drift
#                                            (against the operative keys too)
#   python3 copilot-adapter/setup.py install --refresh-env  rewrite both blocks
#                                            (refused once confirmed)
#
# A harness.yaml you wrote BY HAND carries no markers: `--refresh-env` then
# leaves your operative keys exactly as they are and only appends the
# environment report. Generated sections are rewritten only where this
# generator put them.
# environment_confirmed: false
